---
import { getCollection, type CollectionEntry } from "astro:content";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostSummary } from "@/utils/getPostSummary";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;

const allPosts = getSortedPosts(await getCollection("posts"));
const primaryCat = post.data.categories?.[0];
const sameCat = primaryCat
  ? allPosts.filter(
      p => p.id !== post.id && p.data.categories?.includes(primaryCat)
    )
  : [];
const others = allPosts.filter(
  p => p.id !== post.id && !sameCat.some(s => s.id === p.id)
);
const relatedPosts = [...sameCat, ...others].slice(0, 3);

const emailSubject = encodeURIComponent(`Re: ${post.data.title}`);
---

<section class="border-border bg-muted/25 mt-10 rounded-lg border p-5">
  <div
    class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex items-start gap-4">
      <img
        src={getAssetPath("assets/avatar.jpg")}
        alt={config.site.author}
        width={64}
        height={64}
        loading="lazy"
        class="border-border size-14 shrink-0 rounded-full border object-cover sm:size-16"
      />
      <div>
        <p class="text-accent text-xs font-semibold tracking-wider uppercase">
          Written by
        </p>
        <h2 class="text-foreground mt-0.5 text-lg font-bold">
          {config.site.author}
        </h2>
        <p class="text-foreground/85 mt-1 text-sm">
          Digital Transformation &amp; Technical Leader (20+ yrs · IIM Ahmedabad
          · NIT Jamshedpur). Writing on enterprise AI, platform thinking, and
          technical leadership.
        </p>
      </div>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2 text-xs font-semibold">
      <a
        href="https://www.linkedin.com/in/somnathshukla/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-accent-foreground rounded-md px-3 py-1.5 transition-opacity hover:opacity-90"
      >
        Connect on LinkedIn
      </a>
      <a
        href={getAssetPath("about/")}
        class="border-border text-foreground hover:border-accent hover:text-accent rounded-md border px-3 py-1.5"
      >
        About Somnath
      </a>
    </div>
  </div>
</section>

{
  relatedPosts.length > 0 && (
    <section class="border-border mt-10 border-t pt-8">
      <h2 class="text-xl font-semibold tracking-wide">Related articles</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {relatedPosts.map(related => (
          <a
            href={getPostUrl(related.id, related.filePath, locale)}
            class="group border-border bg-muted/30 hover:border-accent flex flex-col justify-between rounded-lg border p-4 transition-colors"
          >
            <div>
              <h3 class="text-accent font-semibold decoration-dashed underline-offset-4 group-hover:underline">
                {related.data.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm opacity-85">
                {getPostSummary(related, 140)}
              </p>
            </div>
            <time
              class="mt-3 text-xs opacity-70"
              datetime={related.data.pubDatetime.toISOString()}
            >
              {related.data.pubDatetime.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </a>
        ))}
      </div>
    </section>
  )
}

<div class="mt-8 grid gap-4 sm:grid-cols-2">
  <section
    class="border-border bg-muted/40 flex flex-col justify-between rounded-lg border p-5"
  >
    <div>
      <h2 class="text-lg font-semibold">Join the discussion</h2>
      <p class="mt-1 text-sm opacity-85">
        Have a question, counter-example, or executive perspective on this
        article? Continue the conversation on LinkedIn or by email.
      </p>
    </div>
    <div class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
      <a
        href="https://www.linkedin.com/in/somnathshukla/"
        target="_blank"
        rel="noopener noreferrer"
        class="bg-accent text-accent-foreground rounded-md px-3 py-1.5 transition-opacity hover:opacity-90"
      >
        Discuss on LinkedIn
      </a>
      <a
        href={`mailto:som_nitjsr@outlook.com?subject=${emailSubject}`}
        class="border-border text-foreground hover:border-accent hover:text-accent rounded-md border px-3 py-1.5"
      >
        Send an email
      </a>
    </div>
  </section>

  <section
    class="border-border bg-muted/40 flex flex-col justify-between rounded-lg border p-5"
  >
    <div>
      <h2 class="text-lg font-semibold">Stay updated</h2>
      <p class="mt-1 text-sm opacity-85">
        Subscribe via RSS to get new CTO &amp; technology leadership articles as
        they’re published.
      </p>
    </div>
    <p class="mt-4 text-sm">
      <a
        href={getAssetPath("feed.xml")}
        class="text-accent font-medium underline decoration-dashed underline-offset-4"
      >
        Subscribe to RSS (/feed.xml)
      </a>
    </p>
  </section>
</div>
