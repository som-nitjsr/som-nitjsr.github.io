---
import { getCollection, type CollectionEntry } from "astro:content";
import config from "@/config";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostSummary } from "@/utils/getPostSummary";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getAssetPath } from "@/utils/withBase";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const siteUrl = config.site.url.replace(/\/+$/, "");

const allPosts = getSortedPosts(await getCollection("posts"));
const primaryCat = post.data.categories?.[0];
const sameCat = primaryCat
  ? allPosts.filter(
      p => p.id !== post.id && p.data.categories?.includes(primaryCat)
    )
  : [];
const others = allPosts.filter(
  p => p.id !== post.id && !sameCat.some(s => s.id === p.id)
);
const relatedPosts = [...sameCat, ...others].slice(0, 3);

const postPath = getPostUrl(post.id, post.filePath, locale);
const disqusUrl = post.data.legacyUrl
  ? post.data.legacyUrl.trim()
  : `${siteUrl}${postPath}`;
const disqusIdentifier = post.data.identifier?.trim() || postPath;
const showComments = post.data.comments === true;
---

<section class="mt-10 rounded-lg border border-border bg-muted/25 p-5">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-xs font-semibold tracking-wider text-accent uppercase">
        Written by
      </p>
      <h2 class="mt-0.5 text-lg font-bold text-foreground">
        {config.site.author}
      </h2>
      <p class="mt-1 text-sm text-foreground/85">
        Strategic Technology Leader &amp; CTO Advisor (19+ yrs · IIM Ahmedabad ·
        NIT Jamshedpur · CKA · CCSP). Writing on enterprise AI, platform
        thinking, and executive leadership.
      </p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-2 text-xs font-semibold">
      <a
        href="https://www.linkedin.com/in/somnath-shukla/"
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-md bg-accent px-3 py-1.5 text-accent-foreground transition-opacity hover:opacity-90"
      >
        Connect on LinkedIn
      </a>
      <a
        href={getAssetPath("about/")}
        class="rounded-md border border-border px-3 py-1.5 text-foreground hover:border-accent hover:text-accent"
      >
        About Somnath
      </a>
    </div>
  </div>
</section>

{
  relatedPosts.length > 0 && (
    <section class="mt-10 border-t border-border pt-8">
      <h2 class="text-xl font-semibold tracking-wide">Related articles</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3">
        {relatedPosts.map(related => (
          <a
            href={getPostUrl(related.id, related.filePath, locale)}
            class="group flex flex-col justify-between rounded-lg border border-border bg-muted/30 p-4 transition-colors hover:border-accent"
          >
            <div>
              <h3 class="font-semibold text-accent group-hover:underline decoration-dashed underline-offset-4">
                {related.data.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm opacity-85">
                {getPostSummary(related, 140)}
              </p>
            </div>
            <time
              class="mt-3 text-xs opacity-70"
              datetime={related.data.pubDatetime.toISOString()}
            >
              {related.data.pubDatetime.toLocaleDateString("en-US", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })}
            </time>
          </a>
        ))}
      </div>
    </section>
  )
}

<section class="mt-8 rounded-lg border border-border bg-muted/40 p-5">
  <h3 class="text-lg font-semibold">Stay updated</h3>
  <p class="mt-1 text-sm opacity-85">
    Subscribe via RSS to get new CTO &amp; technology leadership articles as
    they’re published.
  </p>
  <p class="mt-2 text-sm">
    <a
      href={getAssetPath("feed.xml")}
      class="font-medium text-accent underline decoration-dashed underline-offset-4"
    >
      Subscribe to RSS (/feed.xml)
    </a>
  </p>
</section>

{
  showComments && (
    <section class="mt-10 border-t border-border pt-8">
      <h2 class="text-xl font-semibold">Comments</h2>
      <p class="mt-1 mb-4 text-sm opacity-80">
        Have a question or a different perspective? Join the discussion below.
      </p>
      <div
        id="disqus_thread"
        data-disqus-url={disqusUrl}
        data-disqus-identifier={disqusIdentifier}
        data-disqus-title={post.data.title}
        class="rounded-lg border border-border bg-white p-4 text-black"
      />
      <noscript>
        Please enable JavaScript to view the{" "}
        <a href="https://disqus.com/?ref_noscript">
          comments powered by Disqus.
        </a>
      </noscript>
    </section>
  )
}

<script is:inline data-astro-rerun>
  (function () {
    const thread = document.getElementById("disqus_thread");
    if (!thread) return;

    const pageUrl = thread.dataset.disqusUrl;
    const pageIdentifier = thread.dataset.disqusIdentifier;
    const pageTitle = thread.dataset.disqusTitle;

    window.disqus_config = function () {
      this.page.url = pageUrl;
      this.page.identifier = pageIdentifier;
      this.page.title = pageTitle;
    };

    if (window.DISQUS) {
      window.DISQUS.reset({
        reload: true,
        config: window.disqus_config,
      });
    } else {
      const d = document;
      const s = d.createElement("script");
      s.src = "https://azureinout.disqus.com/embed.js";
      s.setAttribute("data-timestamp", String(+new Date()));
      s.async = true;
      (d.head || d.body).appendChild(s);
    }
  })();
</script>
