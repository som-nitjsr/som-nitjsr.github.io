---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const about = await getEntry("pages", "about");

if (!about) {
  throw new Error(
    "Missing content entry: `about.md` or `about.mdx` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <div
      class="not-prose border-border bg-muted/25 mb-8 flex flex-col gap-4 rounded-lg border p-5 sm:flex-row sm:items-center"
    >
      <img
        src={getAssetPath("assets/avatar.jpg")}
        alt={config.site.author}
        width={96}
        height={96}
        class="border-accent/30 size-20 shrink-0 rounded-full border-2 object-cover shadow-sm sm:size-24"
      />
      <div>
        <h2 class="text-foreground text-xl font-bold">{config.site.author}</h2>
        <p class="text-accent mt-0.5 text-sm font-medium">
          Digital Transformation &amp; Technical Leader · 20+ Years Experience
        </p>
        <p class="text-foreground/85 mt-1.5 text-sm">
          Executive MBA (IIM Ahmedabad) · B.Tech Hons (NIT Jamshedpur)
        </p>
        <div class="mt-3 flex flex-wrap gap-2 text-xs font-semibold">
          <a
            href="https://www.linkedin.com/in/somnathshukla/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-accent-foreground rounded-md px-3 py-1.5 transition-opacity hover:opacity-90"
          >
            Connect for Speaking &amp; Collaboration →
          </a>
          <a
            href="https://www.credly.com/users/somnath-shukla/badges"
            target="_blank"
            rel="noopener noreferrer"
            class="border-border text-foreground hover:border-accent hover:text-accent rounded-md border px-3 py-1.5"
          >
            View Credly Badges
          </a>
        </div>
      </div>
    </div>

    <Content />
  </Main>

  <Footer />
</Layout>
