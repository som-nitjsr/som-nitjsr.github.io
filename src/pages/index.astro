---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import { getPostSummary } from "@/utils/getPostSummary";
import { getAssetPath } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = await getCollection("posts");
const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts;
const homePath = getRelativeLocaleUrl(locale, "");

const MAX_PER_SECTION = 3;

const orderedSections = [
  "Agentic AI",
  "CTO Leadership",
  "Digital Transformation",
  "Security & Innovation",
];

const featuredBySection = orderedSections
  .map(section => {
    const allInSection = featuredPosts
      .filter(p => p.data.featured_section === section)
      .sort((a, b) => {
        const rankDiff =
          (a.data.featured_rank ?? 999) - (b.data.featured_rank ?? 999);
        if (rankDiff !== 0) return rankDiff;
        return (
          new Date(b.data.pubDatetime).getTime() -
          new Date(a.data.pubDatetime).getTime()
        );
      });
    return {
      section,
      totalCount: allInSection.length,
      items: allInSection.slice(0, MAX_PER_SECTION),
    };
  })
  .filter(group => group.items.length > 0);
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-4 pb-5">
      <div
        class="flex flex-col-reverse items-start justify-between gap-4 sm:flex-row sm:items-center"
      >
        <div class="min-w-0 flex-1">
          <p class="text-accent text-xs font-semibold tracking-wider uppercase">
            Somnath Shukla · Technical Leadership &amp; Business Impact
          </p>
          <div class="mt-1.5 mb-2 flex flex-wrap items-center gap-3">
            <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
              Strategic Insights for Modern CTOs
            </h1>
            <a
              target="_blank"
              href={getAssetPath("feed.xml")}
              class="inline-flex items-center"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="stroke-accent scale-110 stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>
          <p
            class="text-foreground/90 max-w-2xl text-sm leading-relaxed sm:text-base"
          >
            Welcome to the intersection of technology strategy and executive
            leadership. Here, we explore how great Technical Leaders think
            beyond code—building platforms, driving transformation, and leading
            with strategic influence.
          </p>
        </div>
        <img
          src={getAssetPath("assets/avatar.jpg")}
          alt="Somnath Shukla"
          width={112}
          height={112}
          class="border-accent/30 size-20 shrink-0 rounded-full border-2 object-cover shadow-sm sm:size-28"
        />
      </div>

      <blockquote
        class="border-accent text-foreground/85 mt-3 border-s-2 ps-3.5 text-sm italic"
      >
        <span class="text-foreground font-semibold not-italic"
          >Leadership Philosophy:</span
        >{" "}
        “Technology is the tool. People drive transformation. Great CTOs don’t just
        align tech—they align influence across functions.”
      </blockquote>

      <div
        class="text-muted-foreground mt-3 flex flex-wrap items-center gap-2 text-xs"
      >
        <span
          class="border-border bg-muted/40 text-foreground/85 rounded-full border px-2.5 py-0.5 font-medium"
        >
          20+ Yrs Experience
        </span>
        <span
          class="border-border bg-muted/40 text-foreground/85 rounded-full border px-2.5 py-0.5 font-medium"
        >
          Exec MBA, IIM Ahmedabad
        </span>
        <span
          class="border-border bg-muted/40 text-foreground/85 rounded-full border px-2.5 py-0.5 font-medium"
        >
          B.Tech, NIT Jamshedpur
        </span>
      </div>

      <div
        class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm"
      >
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <a
            href="https://www.linkedin.com/in/somnathshukla/"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-accent text-accent-foreground inline-flex items-center rounded-md px-3 py-1.5 text-xs font-semibold transition-opacity hover:opacity-90"
          >
            Connect for Speaking &amp; Collaboration →
          </a>
          <LinkButton
            class="text-accent font-medium underline decoration-dashed underline-offset-4"
            href={getRelativeLocaleUrl(locale, "about")}
          >
            About Somnath
          </LinkButton>
          <span class="text-muted-foreground">·</span>
          <a
            href="https://www.credly.com/users/somnath-shukla/badges"
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent font-medium underline decoration-dashed underline-offset-4"
          >
            Credly Badges
          </a>
        </div>
        {
          socials.length > 0 && (
            <div class="flex items-center gap-2">
              <Socials />
            </div>
          )
        }
      </div>
    </section>

    {
      featuredBySection.length > 0 && (
        <section id="featured" class="border-border border-b pt-10 pb-8">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-bold tracking-tight">Featured Insights</h2>
            <a
              href={getRelativeLocaleUrl(locale, "blog")}
              class="text-accent text-sm font-medium decoration-dashed underline-offset-4 hover:underline"
            >
              View full archive →
            </a>
          </div>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            {featuredBySection.map(({ section, items }) => (
              <div class="border-border bg-muted/20 flex flex-col rounded-lg border p-5">
                <h3 class="border-border text-foreground border-b pb-2 text-lg font-bold">
                  {section}
                </h3>
                <ul class="mt-3.5 space-y-3.5">
                  {items.map(post => (
                    <li>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="text-accent block text-sm leading-snug font-semibold decoration-dashed underline-offset-4 hover:underline"
                      >
                        {post.data.title}
                      </a>
                      <p class="text-muted-foreground mt-1 line-clamp-1 text-xs">
                        {getPostSummary(post, 100)}
                      </p>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <section class="border-border border-b py-8">
      <h2 class="text-2xl font-bold tracking-tight">
        Strategic Expertise Areas
      </h2>
      <div class="border-border mt-4 overflow-x-auto rounded-lg border">
        <table class="w-full text-left text-sm">
          <thead class="border-border bg-muted/35 border-b">
            <tr>
              <th class="text-foreground px-4 py-2.5 font-bold">Leadership</th>
              <th class="text-foreground px-4 py-2.5 font-bold">Technology</th>
              <th class="text-foreground px-4 py-2.5 font-bold">Innovation</th>
            </tr>
          </thead>
          <tbody class="divide-border text-foreground/85 divide-y">
            <tr>
              <td class="px-4 py-2">• Executive Storytelling</td>
              <td class="px-4 py-2">• Multi-Cloud Architecture</td>
              <td class="px-4 py-2">• Generative &amp; Agentic AI</td>
            </tr>
            <tr>
              <td class="px-4 py-2">• Strategic Influence</td>
              <td class="px-4 py-2">• Platform Thinking</td>
              <td class="px-4 py-2">• IoT &amp; Edge Computing</td>
            </tr>
            <tr>
              <td class="px-4 py-2">• Financial Literacy</td>
              <td class="px-4 py-2">• Security-First Design</td>
              <td class="px-4 py-2">• Digital Transformation</td>
            </tr>
            <tr>
              <td class="px-4 py-2">• Cross-Functional Alignment</td>
              <td class="px-4 py-2">• Kubernetes &amp; Containers</td>
              <td class="px-4 py-2">• Sustainable Tech</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="border-border border-b py-8">
      <h2 class="text-2xl font-bold tracking-tight">
        Why This Matters for CTOs
      </h2>
      <ul class="text-foreground/90 mt-3 space-y-2 text-sm">
        <li>
          <strong class="text-foreground font-semibold"
            >Technology serves business strategy</strong
          > — not the other way around
        </li>
        <li>
          <strong class="text-foreground font-semibold"
            >Platform thinking</strong
          > creates exponential value over project-based approaches
        </li>
        <li>
          <strong class="text-foreground font-semibold"
            >Strategic influence</strong
          > matters more than technical control
        </li>
        <li>
          <strong class="text-foreground font-semibold"
            >Digital transformation</strong
          > requires cultural change, not just technology
        </li>
      </ul>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-8 pb-4">
          <h2 class="text-2xl font-bold tracking-tight">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.slice(0, postsConfig.perIndex).map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-6 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
