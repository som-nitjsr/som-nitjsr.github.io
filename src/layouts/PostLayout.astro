---
import Layout from "./Layout.astro";
import config from "@/config";

type FaqItem = {
  q: string;
  a: string;
};

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  pubDatetime?: Date;
  modDatetime?: Date | null;
  categories?: string[];
  tags?: string[];
  wordCount?: number;
  faq?: FaqItem[];
};

const { site } = config;
const siteUrl = site.url.replace(/\/+$/, "");

const {
  title,
  description,
  ogImage,
  canonicalURL,
  pubDatetime,
  modDatetime,
  categories,
  tags,
  wordCount,
  faq,
} = Astro.props;

const resolvedCanonical =
  canonicalURL ?? new URL(Astro.url.pathname, Astro.site).href;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title ?? site.title,
  description: description ?? site.description,
  url: resolvedCanonical,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": resolvedCanonical,
  },
  image: ogImage,
  ...(pubDatetime && { datePublished: pubDatetime.toISOString() }),
  ...(modDatetime && { dateModified: modDatetime.toISOString() }),
  ...(categories && categories.length > 0 && { articleSection: categories[0] }),
  ...(tags && tags.length > 0 && { keywords: tags.join(", ") }),
  ...(wordCount && { wordCount }),
  author: [
    {
      "@type": "Person",
      "@id": `${siteUrl}/about/#person`,
      name: site.author,
      ...(site.profile && { url: site.profile }),
    },
  ],
  publisher: {
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: site.title,
    url: siteUrl,
  },
};

const structuredDataJson = JSON.stringify(structuredData).replace(
  /</g,
  "\\u003c"
);

const faqSchemaJson =
  faq && faq.length > 0
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: faq.map(item => ({
          "@type": "Question",
          name: item.q,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.a,
          },
        })),
      }).replace(/</g, "\\u003c")
    : null;
---

<Layout {title} {description} {ogImage} {canonicalURL}>
  <Fragment slot="head">
    <meta property="og:type" content="article" />

    {
      pubDatetime && (
        <meta
          property="article:published_time"
          content={pubDatetime.toISOString()}
        />
      )
    }
    {
      modDatetime && (
        <meta
          property="article:modified_time"
          content={modDatetime.toISOString()}
        />
      )
    }

    <script
      type="application/ld+json"
      is:inline
      set:html={structuredDataJson}
    />
    {
      faqSchemaJson && (
        <script type="application/ld+json" is:inline set:html={faqSchemaJson} />
      )
    }
  </Fragment>

  <slot />
</Layout>
